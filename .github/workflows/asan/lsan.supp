# Python module teardown leaves some strings and floats allocated.
# These rules also hide runtime leaks of those types.
leak:^PyUnicode_New$
leak:^resize_compact$
leak:^PyFloat_FromDouble$

# Boost.Python caches demangled type names without freeing the cached strings.
# https://github.com/boostorg/python/blob/boost-1.90.0/src/converter/type_id.cpp
leak:^d_growable_string_callback_adapter$

# Matplotlib's pybind11 function-record wrappers are not freed at shutdown.
# Fast allocation stacks stop at this Python allocator before its caller.
# This also hides other leaks allocated through _PyObject_New, including
# fixed-size Python extension objects. PyObject_Malloc and the native C++
# allocation functions are not suppressed as a group.
# https://github.com/pybind/pybind11/blob/v3.0.1/include/pybind11/pybind11.h
leak:^_PyObject_New$
