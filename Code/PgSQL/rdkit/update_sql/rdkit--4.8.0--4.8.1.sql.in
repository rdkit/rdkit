-- Qualify SQL wrapper calls to the extension's own functions.

CREATE OR REPLACE FUNCTION mol_from_smiles(text)
RETURNS mol
PARALLEL SAFE
AS 'select \@extschema\@.mol_from_smiles($1::cstring);'
LANGUAGE SQL IMMUTABLE
RETURNS NULL ON NULL INPUT;

CREATE OR REPLACE FUNCTION fmcs_smiles(text, text)
RETURNS text
PARALLEL SAFE
AS 'SELECT CAST( \@extschema\@.fmcs_smiles(CAST($1 AS CSTRING), CAST($2 AS CSTRING)) AS text);'
LANGUAGE SQL IMMUTABLE;

CREATE OR REPLACE FUNCTION fmcs_smiles(text)
RETURNS text
PARALLEL SAFE
AS 'SELECT CAST( \@extschema\@.fmcs_smiles(CAST($1 AS CSTRING), CAST('''' AS CSTRING)) AS text);'
LANGUAGE SQL IMMUTABLE;
